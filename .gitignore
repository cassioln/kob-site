# Backups e rascunhos locais (snapshots do browser, drafts de recuperação)
bkp/

# Arquivos da ferramenta Hermes (attachments, cache)
.hermes/

# Worktrees locais de desenvolvimento
.worktrees/

# Sistema
.DS_Store
*.log

# Credenciais server-side (mantenha apenas o modelo versionado)
.env
.env.*
!.env.example

# Dependências e artefatos de testes locais
node_modules/
**/node_modules/
.npm/
.pnp.*
test-results/
playwright-report/
blob-report/
.cache/
.playwright/
playwright/.cache/

# Scripts temporários de automação (CDP/Playwright ad-hoc na raiz)
# NÃO ignora playwright.config.mjs / playwright.live.config.mjs (versionados).
/gtm-*.mjs
/ga4-*.mjs
/ta-*.mjs
/prod-*.mjs
/realtime-*.mjs
/final-*.mjs

# Loop finder
loop_finder/*

# Scripts temporários de operação/diagnóstico (caminhos e fluxos locais)
.hermes-tmp/
