{
  "name": "kob-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:analytics && npm run test:analytics:pii",
    "test:analytics": "playwright test",
    "test:analytics:pii": "playwright test --config=playwright.live.config.mjs --grep @code",
    "test:analytics:live": "playwright test --config=playwright.live.config.mjs",
    "test:analytics:headed": "playwright test --headed",
    "validate:analytics": "node analytics/scripts/validate-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
