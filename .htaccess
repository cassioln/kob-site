##### LOCAWEB - NAO REMOVER #####
AddHandler php80-script .php
suPHP_ConfigPath /home/kriativosonboard2/
##### LOCAWEB - NAO REMOVER #####

# ==========================================================================
# Kriativos On Board - Landing page estatica | Configuracao Apache
# Basta subir todo o conteudo da raiz do repositorio para o document root do host.
#
# ATENCAO ao bloco LOCAWEB acima: e ele que define a versao do PHP no host.
# O painel da Locaweb grava esse AddHandler no .htaccess do servidor; como o
# nosso deploy sobrescreve o arquivo inteiro, sem essas linhas o host volta ao
# PHP 5.2.17 padrao e TODOS os endpoints passam a devolver HTTP 500 (o parser
# antigo rejeita `declare(strict_types=1)`, tipos em assinatura e `??`).
#
# Ja aconteceu duas vezes. Se trocar a versao pelo painel, atualize aqui
# tambem (ex.: php81-script), senao o proximo deploy desfaz a mudanca.
# Documentacao: https://www.locaweb.com.br/ajuda/wiki/como-alterar-a-versao-do-php-hospedagem-de-sites-ajuda-locaweb/
# ==========================================================================

RewriteEngine On

# Redireciona www -> dominio raiz (ajuste se preferir com www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---- Subdominio busao.kriativosonboard.com.br (e onibus.kriativosonboard.com.br) ----
# Serve onibus.html diretamente ao acessar a raiz do subdominio, mantendo a URL limpa
RewriteCond %{HTTP_HOST} ^(busao|onibus)\.kriativosonboard\.com\.br$ [NC]
RewriteRule ^$ onibus.html [L]
RewriteCond %{HTTP_HOST} ^(busao|onibus)\.kriativosonboard\.com\.br$ [NC]
RewriteRule ^index\.html$ onibus.html [L]

# ---- Subdominio painel.kriativosonboard.com.br ----
# Serve painel-onibus.html na raiz do subdominio painel
RewriteCond %{HTTP_HOST} ^painel\.kriativosonboard\.com\.br$ [NC]
RewriteRule ^$ painel-onibus.html [L]
RewriteCond %{HTTP_HOST} ^painel\.kriativosonboard\.com\.br$ [NC]
RewriteRule ^index\.html$ painel-onibus.html [L]

# ---- API do onibus fretado ----
# O frontend (assets/js/onibus.js) chama /api/<endpoint>. Os arquivos reais
# ficam em php/mysql/. Sem estas regras as rotas retornam 404, porque o host
# serve o repositorio como conteudo estatico.
#
# Runtime escolhido: PHP 8.0 + MySQL (Percona 5.7) na Locaweb. O PostgreSQL
# do mesmo plano NAO serve aqui: exige scram-sha-256 e a libpq do host e 9.5,
# que falha com "authentication method 10 not supported". Ver
# ONIBUS-PAGAMENTO.md. Por isso apontamos para php/mysql/, nao para php/.
#
# QSA preserva a query string (bus-registration-status?id=UUID depende dela).
# L encerra o processamento para a requisicao nao cair no 404 do final.
RewriteRule ^api/create-pix-order/?$          php/mysql/create-pix-order.php [QSA,L]
RewriteRule ^api/bus-registration-status/?$   php/mysql/bus-registration-status.php [QSA,L]
# Lista de embarque da organizacao. Exige token (bus-secrets.php) e devolve 404
# sem ele, para nao confirmar a existencia do endpoint a quem sonda.
RewriteRule ^api/bus-manifest/?$              php/mysql/bus-manifest.php [QSA,L]
# Dados do painel da organizacao (JSON agregado). Mesmo token do manifest.
RewriteRule ^api/bus-admin-data/?$            php/mysql/bus-admin-data.php [QSA,L]
# Exportacao .xlsx do painel. Mesmo token do manifest.
RewriteRule ^api/bus-admin-xlsx/?$            php/mysql/bus-admin-xlsx.php [QSA,L]
# Configuracoes e alocacao de frota do painel
RewriteRule ^api/bus-settings-update/?$       php/mysql/bus-settings-update.php [QSA,L]
RewriteRule ^api/bus-fleet-assign/?$          php/mysql/bus-fleet-assign.php [QSA,L]
RewriteRule ^api/bus-fleet-auto-balance/?$    php/mysql/bus-fleet-auto-balance.php [QSA,L]
RewriteRule ^api/bus-vip-create/?$            php/mysql/bus-vip-create.php [QSA,L]
RewriteRule ^api/bus-vip-delete/?$            php/mysql/bus-vip-delete.php [QSA,L]
RewriteRule ^api/bus-payment-proof/?$         php/mysql/bus-payment-proof.php [QSA,L]
RewriteRule ^api/mercadopago-webhook/?$       php/mysql/mercadopago-webhook.php [QSA,L]

DirectoryIndex index.html
ErrorDocument 404 /index.html

# ---- Proteger codigo server-side ----
# O deploy por FTP publica a raiz do repositorio, entao estes diretorios
# chegam ao document root. As credenciais em si NAO ficam aqui (moram em
# ~/kob-config/bus-secrets.php, fora do document root), mas expor as libs,
# o schema SQL e codigo que nunca executa neste host e superficie inutil.
#
# ATENCAO: <Directory> e <DirectoryMatch> sao ILEGAIS em .htaccess e causam
# HTTP 500 em toda a requisicao ("<DirectoryMatch not allowed here").
# Verificado com Apache 2.4.66 local. Em .htaccess a protecao por caminho
# precisa ser feita via mod_rewrite.
#
# Os endpoints em php/mysql/*.php continuam acessiveis: sao eles que os
# RewriteRule de /api/ atingem. Um require interno do PHP e resolvido no
# filesystem e nao passa pelo controle de acesso do Apache, entao bloquear
# os diretorios de apoio nao quebra os endpoints.
RewriteRule ^php/lib/          - [F,L]
RewriteRule ^php/mysql/lib/    - [F,L]
RewriteRule ^php/db/           - [F,L]
RewriteRule ^server/           - [F,L]
RewriteRule ^netlify/          - [F,L]
RewriteRule ^api/.*\.mjs$      - [F,L]

# Os endpoints PostgreSQL em php/*.php sao codigo morto NESTE host: a libpq
# da Locaweb e 9.5 e nao fala scram-sha-256, entao eles nunca funcionam aqui.
# Ficam no repositorio para quem rodar em outro runtime, mas nao devem ser
# alcancaveis pela web. Sao bloqueados um a um, porque um "^php/" generico
# tambem barraria php/mysql/, que precisa continuar servindo a API.
RewriteRule ^php/create-pix-order\.php$        - [F,L]
RewriteRule ^php/bus-registration-status\.php$ - [F,L]
RewriteRule ^php/bus-payment-proof\.php$      - [F,L]
RewriteRule ^php/mercadopago-webhook\.php$    - [F,L]

# Arquivos sensiveis que nunca devem ser servidos, caso cheguem ao host.
# <FilesMatch> e permitido em .htaccess (diferente de <DirectoryMatch>).
<FilesMatch "^(\.env.*|\.gitignore|package(-lock)?\.json|.*\.sql|.*\.mjs)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>


# ---- Tipos MIME ----
# A hospedagem da Locaweb entrega extensões modernas como text/plain por
# padrão. Além de prejudicar o cache por tipo, isso conflita com nosniff.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/javascript .js
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

# ---- Cabecalhos de seguranca ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- Cache de assets estaticos ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

# ---- Compressao ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
