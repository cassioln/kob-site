# Credenciais server-side. NUNCA versione um .env real.
# O .gitignore já protege .env e .env.*, com exceção deste modelo.

# ── Mercado Pago ──────────────────────────────────────────────────────────
# Access Token PRIVADO (sandbox ou produção). Só no servidor: nunca no HTML,
# no JS do cliente ou em commit. A Public Key pode ir ao frontend, mas o
# fluxo Pix atual não precisa dela.
MERCADOPAGO_ACCESS_TOKEN=APP_USR_REPLACE_ME
MERCADOPAGO_PUBLIC_KEY=APP_USR_REPLACE_ME

# ── Opção A: PostgreSQL (funciona com o backend Node) ─────────────────────
# Host confirmado: db_kob.postgresql.dbaas.com.br:5432 — PostgreSQL 15.6.
# ATENÇÃO: só funciona com Node. O PHP da Locaweb NÃO consegue conectar,
# porque a libpq do host é 9.5 e não fala SCRAM-SHA-256 (erro
# "authentication method 10 not supported").
DATABASE_URL=postgresql://db_kob:SENHA@db_kob.postgresql.dbaas.com.br:5432/db_kob

# O certificado TLS desse servidor está EXPIRADO (CERT_HAS_EXPIRED). Sem a
# linha abaixo o driver `pg` recusa a conexão e nada é gravado. O tráfego
# continua cifrado; abre-se mão da validação da cadeia. Remova quando a
# Locaweb renovar o certificado.
PGSSL_REJECT_UNAUTHORIZED=false

# ── Opção B: MySQL (funciona com o backend PHP na Locaweb) ────────────────
# Host: 186.202.152.70:3306 — Percona Server 5.7.32 (aceita conexão externa).
# O pdo_mysql do PHP 8.0 usa mysqlnd embutido, então não sofre o problema
# de autenticação da libpq.
# ATENÇÃO 5.7: CHECK constraints são aceitas e IGNORADAS silenciosamente.
# As regras de negócio dependem das TRIGGERS de
# php/db/001_bus_registrations_mysql.sql — não remova.
MYSQL_HOST=186.202.152.70
MYSQL_PORT=3306
MYSQL_DATABASE=db_kob_msql
MYSQL_USER=db_kob_msql
MYSQL_PASSWORD=REPLACE_ME

# Em produção (PHP na Locaweb) a senha NÃO vem deste arquivo: ela fica em
# ~/kob-config/bus-secrets.php, fora do document root.

# ── CORS (só necessário se a API Node rodar em subdomínio separado) ────────
# Allowlist explícita, separada por vírgula. Nunca use "*" aqui: o parser
# descarta wildcard de propósito. Se não definida, o default seguro é
# https://kriativosonboard.com.br + https://www.kriativosonboard.com.br
# (ver server/cors.mjs). Irrelevante na opção PHP, que é mesmo domínio.
ALLOWED_ORIGINS=https://kriativosonboard.com.br,https://www.kriativosonboard.com.br
